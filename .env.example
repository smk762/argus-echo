# Copy to .env. Every value is optional; compose.yaml falls back to the defaults shown.
# Reference: docs/api.md, docs/miso-config.md, docs/xtts.md, docs/qwen.md.

# ── Network ───────────────────────────────────────────────────────────────────
# Every port is published as ECHO_BIND:<port>. 127.0.0.1 keeps the engines on this
# machine; 0.0.0.0 or a LAN address serves other machines. Only /admin/* is
# authenticated, so expose the ports only on a network you trust.
ECHO_BIND=127.0.0.1
MISO_PORT=8140
XTTS_PORT=8141
QWEN_PORT=8142
WHISPER_PORT=8144
WYOMING_XTTS_PORT=10240
WYOMING_MISO_PORT=10241
WYOMING_QWEN_PORT=10242
WYOMING_WHISPER_PORT=10243
# Image tag compose pulls or builds: `local` builds from source; a release tag pulls ghcr.io/smk762/argus-echo-*.
ECHO_TAG=local
NVIDIA_VISIBLE_DEVICES=all

# ── Admin ─────────────────────────────────────────────────────────────────────
# Bearer token for /admin/* on every engine (argus-iris sends it). Empty = admin routes
# answer 503. Generate with `openssl rand -hex 32`; never commit it.
ARGUS_ADMIN_TOKEN=
# 1 opens /admin/* while ARGUS_ADMIN_TOKEN is empty. Local development only.
ARGUS_ADMIN_INSECURE=

# ── Storage (S3 / MinIO) ──────────────────────────────────────────────────────
# One endpoint, one bucket per engine (clones share key names but not formats).
# Create the buckets first. *_S3_PUBLIC_URL is the base clients fetch audio from,
# e.g. http://minio.lan:9000/voice-xtts.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MISO_S3_BUCKET=voice-miso
MISO_S3_PUBLIC_URL=
XTTS_S3_BUCKET=voice-xtts
XTTS_S3_PUBLIC_URL=
QWEN_S3_BUCKET=voice-qwen
QWEN_S3_PUBLIC_URL=

# ── Miso ──────────────────────────────────────────────────────────────────────
HF_TOKEN=
# Hugging Face cache; point at an existing one to reuse a downloaded checkpoint.
HF_HOME=./cache/huggingface
MISO_MODEL=MisoLabs/MisoTTS
MISO_TTS_TOKENIZER=unsloth/Llama-3.2-1B
MISO_PRELOAD=0
# local: files under MISO_DATA_DIR, served by Miso at /media/{key}; s3: the bucket above.
MISO_STORAGE_BACKEND=local
MISO_DATA_DIR=./data/miso
# Base of the audio_url Miso returns with the local backend: the URL clients use.
MISO_PUBLIC_URL=http://localhost:8140
MISO_KEEP_ALIVE_GPU=300
MISO_KEEP_ALIVE_CPU=0
MISO_NO_CUDA_GRAPH=1
# Speech-to-text engine that transcribes /clone-voice clips sent without reference_text,
# e.g. http://whisper:8031 (the whisper profile). Empty: such clones have no transcript.
MISO_STT_URL=
MISO_STT_TIMEOUT_S=60

# ── XTTS-v2 ───────────────────────────────────────────────────────────────────
XTTS_DEVICE=cuda:0
XTTS_PRELOAD=0
XTTS_KEEP_ALIVE_GPU=120
XTTS_KEEP_ALIVE_CPU=600

# ── Qwen3-TTS ─────────────────────────────────────────────────────────────────
# 0.6b or 1.7b; also the image build arg (the weights are baked in).
QWEN_MODEL_SIZE=0.6b
QWEN_DEVICE=cuda:0
# both, custom_voice (built-in speakers only: about half the VRAM, no cloning) or base (cloning only).
QWEN_LOAD_MODELS=both
# Speaker for a request that names none (e.g. vivian, ryan); empty leaves it to the request.
QWEN_DEFAULT_SPEAKER=
QWEN_PRELOAD=0
QWEN_KEEP_ALIVE_GPU=120
QWEN_KEEP_ALIVE_CPU=600

# ── Wyoming bridges ───────────────────────────────────────────────────────────
# The engine each bridge forwards to (TTS: wyoming-xtts, -miso, -qwen; ASR: wyoming-whisper); defaults are the engine in this compose project.
WYOMING_XTTS_ENGINE_URL=http://xtts:8031
WYOMING_MISO_ENGINE_URL=http://miso:8031
WYOMING_QWEN_ENGINE_URL=http://qwen:8031
# Qwen built-in speaker the bridge uses when Home Assistant names none.
WYOMING_QWEN_SPEAKER=ryan
# The ASR bridge (wyoming-whisper) forwards to the whisper engine's POST /transcribe.
WYOMING_WHISPER_ENGINE_URL=http://whisper:8031
# Blank: the language Home Assistant sends, else detect. Seconds to wait for a transcript.
WYOMING_WHISPER_LANGUAGE=
WYOMING_WHISPER_TIMEOUT=120

# ── Whisper (speech to text) ──────────────────────────────────────────────────
# compose maps WHISPER_* onto the engine's STT_* variables. Reference: docs/api.md, "Speech to text".
WHISPER_DEVICE=cuda
WHISPER_PRELOAD=0
WHISPER_KEEP_ALIVE_GPU=300
WHISPER_KEEP_ALIVE_CPU=600
WHISPER_BEAM_SIZE=5
WHISPER_MAX_UPLOAD_MB=50
WHISPER_MAX_SECONDS=600
WHISPER_QUEUE_TIMEOUT_S=30
WHISPER_STREAM_MAX_SESSIONS=4
# POST /transcriptions (agent-composer's JSON route, for kimini-api). 1: Silero VAD drops silence before Whisper
# runs, as composer did (/transcribe never uses it).
WHISPER_VAD_FILTER=1
# audio_url is fetched only from hosts whose every address is public. List trusted internal hosts (`host` or
# `host:port`, comma-separated) to allow them anyway, e.g. minio:9000. Redirects followed (each re-checked): 0 = none.
WHISPER_AUDIO_URL_ALLOWED_HOSTS=
WHISPER_AUDIO_URL_MAX_REDIRECTS=0
WHISPER_DOWNLOAD_TIMEOUT=30
# ffmpeg demuxers for audio that isn't WAV/FLAC (never a playlist demuxer such as hls or concat); none = WAV/FLAC only.
WHISPER_INPUT_FORMATS=wav,w64,mp3,ogg,flac,webm,matroska,mp4,m4a,aac,aiff,caf,amr,au
WHISPER_DECODE_TIMEOUT=120
